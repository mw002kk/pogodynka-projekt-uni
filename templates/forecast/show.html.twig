{% extends 'base.html.twig' %}

{% block title %}Forecast details{% endblock %}

{% block body %}
    <h1>Forecast details</h1>

    <table class="table table-bordered">
        <tbody>
        <tr>
            <th>City</th>
            <td>{{ forecast.location.city }}</td>
        </tr>
        <tr>
            <th>Date</th>
            <td>{{ forecast.date|date('Y-m-d H:i') }}</td>
        </tr>
        <tr>
            <th>Temperature</th>
            <td>{{ forecast.temperature }}</td>
        </tr>
        <tr>
            <th>Humidity</th>
            <td>{{ forecast.humidity }}%</td>
        </tr>
        <tr>
            <th>Precipitation</th>
            <td>{{ forecast.precipitation }}</td>
        </tr>
        <tr>
            <th>Wind speed</th>
            <td>{{ forecast.windSpeed }}</td>
        </tr>
        <tr>
            <th>Wind gusts speed</th>
            <td>{{ forecast.windGustsSpeed }}</td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('app_forecast_edit', {'id': forecast.id}) }}" class="btn btn-warning">
        Edit
    </a>

    <a href="{{ path('app_forecast_index') }}" class="btn btn-secondary">
        Back to list
    </a>
    {{ include('forecast/_delete_form.html.twig') }}
{% endblock %}
